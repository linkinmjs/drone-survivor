[gd_scene format=3]

[ext_resource type="Script" path="res://gui/rounds_menu.gd" id="1_rounds"]

[node name="RoundsMenu" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_rounds")

[node name="PanelContainer" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(900, 0)
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 3
theme_type_variation = &"Card"

[node name="Column" type="VBoxContainer" parent="PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="PanelContainer/Column"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "ROUND_MENU_TITLE"

[node name="Subtitle" type="Label" parent="PanelContainer/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"

[node name="Scroll" type="ScrollContainer" parent="PanelContainer/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="PanelContainer/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Detail" type="Label" parent="PanelContainer/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_type_variation = &"CaptionLabel"
autowrap_mode = 3
vertical_alignment = 1

[node name="Footer" type="HBoxContainer" parent="PanelContainer/Column"]
layout_mode = 2
alignment = 2

[node name="ButtonBack" type="Button" parent="PanelContainer/Column/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GhostButton"
text = "UI_BACK"
metadata/ui_back = true
