[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; Suelo de la galería de assets (`tools/asset_gallery.tscn`, plan P2e): gris
; oscuro con una rejilla de 10 m y una línea más marcada cada 100 m, dibujada en
; coordenadas de mundo para que la rejilla sirva de regla aunque el plano cambie
; de tamaño. Lo escribe a mano WP-G; el horneador de la galería sólo lo nombra.
; P2f (luz de estudio): líneas apagadas —la de 10 m de 0,36–0,42 a 0,25–0,29 y
; la de 100 m de ámbar 0,62·0,52·0,34 a 0,38·0,34·0,28— para que con el sol de
; frente el suelo no compita con las piezas ni con las etiquetas ámbar.

[sub_resource type="Shader" id="Shader_gallery_grid"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform vec4 base_color : source_color = vec4(0.15, 0.16, 0.18, 1.0);
uniform vec4 line_color : source_color = vec4(0.25, 0.26, 0.29, 1.0);
uniform vec4 major_color : source_color = vec4(0.38, 0.34, 0.28, 1.0);
uniform float cell = 10.0;
uniform float major_cell = 100.0;
uniform float line_width = 0.06;
uniform float major_width = 0.25;

varying vec3 world_position;

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

float grid_line(vec2 at, float size, float width) {
	vec2 distance_to_line = abs(fract(at / size + 0.5) - 0.5) * size;
	vec2 blur = fwidth(at) * 1.5;
	vec2 hit = 1.0 - smoothstep(vec2(width), vec2(width) + blur, distance_to_line);
	// A lo lejos la celda ocupa pocos pixeles y las lineas se funden en un gris
	// parejo que se come lo que esta apoyado encima: se apagan antes.
	float fade = 1.0 - smoothstep(0.04, 0.12, max(blur.x, blur.y) / size);
	return max(hit.x, hit.y) * fade;
}

void fragment() {
	float minor = grid_line(world_position.xz, cell, line_width);
	float major = grid_line(world_position.xz, major_cell, major_width);
	vec3 color = mix(base_color.rgb, line_color.rgb, minor);
	color = mix(color, major_color.rgb, major);
	ALBEDO = color;
	ROUGHNESS = 0.95;
	SPECULAR = 0.25;
}
"

[resource]
resource_name = "gallery_grid"
shader = SubResource("Shader_gallery_grid")
