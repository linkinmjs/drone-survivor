[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

[ext_resource type="Texture2D" path="res://assets/town/nuke_town_palette.png" id="1_albedo"]
[ext_resource type="Texture2D" path="res://assets/town/nuke_town_emissive.png" id="2_emission"]

[resource]
resource_name = "town_houses_windows"
albedo_texture = ExtResource("1_albedo")
metallic_specular = 0.25
roughness = 0.85
emission_enabled = true
; WP-D3, defecto 4, ver `assets/city/materials/buildings_001.tres`. El tinte es
; mas suave que el de la ciudad -(1,00 0,82 0,58) y no (1,00 0,72 0,35)- porque
; la mascara del pack Nuke **ya** sale tibia: `nuke_town.json` pinta el indice 7
; en (198,152,100), el 50 en (74,57,37) y el 13 en (32,24,16). Multiplicar eso
; por el ambar entero lo llevaba al naranja y las casas quedaban con ventanas de
; fogata. Con este tinte la luminancia del nucleo baja al 0,84 de lo que era y el
; tono se queda del lado del ambar sin pasarse.
emission = Color(1, 0.82, 0.58, 1)
; `emission_operator` 1 es MULTIPLY, igual que en `assets/city/materials/*.tres`
; (nota de WP-24). Con el ADD de fabrica un `emission` blanco enciende la casa
; entera; con MULTIPLY el pixel de la mascara **es** el color y el brillo, y la
; mascara es negra en todos los indices que no son ventana, asi que solo se
; encienden los 3 indices de `nuke_town_emissive.png`.
emission_operator = 1
; El mismo 0.65 del rebalance de legibilidad del checkpoint 4. El racionado por
; manzana de `docs/13` §1 sigue funcionando: `Building._resolve_dark_material()`
; duplica este material y pone el multiplicador en 0.0 para las manzanas
; sorteadas, porque `emission_enabled` esta puesto.
emission_energy_multiplier = 0.65
emission_texture = ExtResource("2_emission")
; 0 = TEXTURE_FILTER_NEAREST: ver `town_houses_opaque.tres`. En la mascara importa
; todavia mas, porque un pixel encendido junto a 255 apagados sangraria sobre toda
; la fachada.
texture_filter = 0
