[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://drone/drone_rig.gd" id="1_rig"]
[ext_resource type="PackedScene" path="res://drone/drones/drone_quad.tscn" id="2_drone"]
[ext_resource type="Script" path="res://drone/flight/flight_controller.gd" id="3_controller"]
[ext_resource type="Script" path="res://drone/radio/radio_controller.gd" id="4_radio"]
[ext_resource type="Script" path="res://drone/camera_rig.gd" id="5_camera_rig"]
[ext_resource type="Script" path="res://drone/fpv_camera/fpv_camera.gd" id="6_fpv_camera"]
[ext_resource type="PackedScene" path="res://hud/hud.tscn" id="7_flight_hud"]
[ext_resource type="Script" path="res://drone/damage/respawn_controller.gd" id="8_respawn"]
[ext_resource type="Script" path="res://drone/fpv_camera/fpv_overlay.gd" id="9_overlay"]

[node name="DroneRig" type="Node3D"]
script = ExtResource("1_rig")

[node name="Drone" parent="." node_paths=PackedStringArray("controller") instance=ExtResource("2_drone")]
controller = NodePath("FlightController")

[node name="FlightController" type="Node" parent="Drone" node_paths=PackedStringArray("drone")]
script = ExtResource("3_controller")
drone = NodePath("..")

[node name="CameraRig" type="Node3D" parent="Drone"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.048, -0.05)
script = ExtResource("5_camera_rig")

[node name="FPVCamera" type="Camera3D" parent="Drone/CameraRig"]
keep_aspect = 0
cull_mask = 524287
far = 2000.0
near = 0.02
script = ExtResource("6_fpv_camera")

; `Overlay` (WP-28, `docs/13` §7): la señal de video del dron —viñeta, grano,
; scanlines, aberración, daño y EMP— en la capa de canvas **−1**. Va entre el compuesto
; del ojo de pez (capa −2, lo arma la `FPVCamera` en código) y el `FlightHUD` (capa 0),
; así que procesa la imagen y deja el instrumental nítido encima. Es hermano del `Drone`
; y **no** hijo suyo por la misma razón que el HUD: un `CanvasLayer` dibuja en la
; viewport, no en el espacio del nodo, y colgarlo del cuerpo solo escondería esa
; verdad. Se alimenta solo (`Events.hull_changed` y `EnergySystem.emp_hit`); el rig lo
; reexpone con `get_overlay()`.
;
; Va **después** del `Drone` a propósito: `battle_level`, `audio_check`, `energy_check`,
; `flight_check`, `flight_sandbox` y `weapon_check` sobrescriben al `Drone` por
; `index="0"`, y un nodo nuevo delante les correría el índice.

[node name="Overlay" type="CanvasLayer" parent="."]
layer = -1
script = ExtResource("9_overlay")

; `FlightHUD` (WP-08, `docs/12` §2): hermano del `Drone`, como manda `docs/03` §8. Es
; un `Control` bajo un `Node3D`, así que se dibuja en la capa 0 del canvas de la
; viewport —encima del compuesto del ojo de pez, que vive en la −2— y queda fuera de
; sus `SubViewport`: no se deforma con la imagen. Lo alimenta `drone_rig.gd`.

[node name="FlightHUD" parent="." instance=ExtResource("7_flight_hud")]

[node name="RadioController" type="Node" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("4_radio")
target = NodePath("../Drone")

; `RespawnController` (WP-15, `docs/09` §2.8): hermano del `Drone` y **no** hijo
; suyo, porque tiene que seguir contando mientras el dron está congelado e
; invisible. Resuelve solo sus referencias (`Drone`, `Drone/Hull`,
; `Drone/EnergySystem`, `Drone/WeaponMount`, `Drone/CameraRig/FPVCamera`) en su
; `_ready()`: los cuatro últimos viven dentro de la instancia de `drone_quad.tscn`
; y un `NodePath` del `.tscn` hacia adentro de una escena instanciada es frágil.

[node name="RespawnController" type="Node" parent="."]
script = ExtResource("8_respawn")
