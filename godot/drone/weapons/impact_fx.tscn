[gd_scene load_steps=5 format=3]

; Una instancia del pool de impactos (`docs/08` §2.10). El `Decal` no está acá a
; propósito: vive 8 s y estas chispas 0.35 s, así que los decals son un pool aparte
; dentro de `impact_fx_pool.gd`.

[ext_resource type="Script" path="res://drone/weapons/impact_fx.gd" id="1_impact_fx"]

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_sparks"]
lifetime_randomness = 0.35
emission_shape = 1
emission_sphere_radius = 0.12
direction = Vector3(0, 0, 1)
spread = 55.0
initial_velocity_min = 2.5
initial_velocity_max = 7.0
gravity = Vector3(0, -12, 0)
damping_min = 2.0
damping_max = 6.0
scale_min = 0.45
scale_max = 1.0
color = Color(0.95, 0.9, 0.78, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_spark"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 0.85, 0.6, 1)
emission_enabled = true
emission = Color(1, 0.8, 0.45, 1)
emission_energy_multiplier = 6.0
billboard_mode = 3
billboard_keep_scale = true
disable_receive_shadows = true

[sub_resource type="QuadMesh" id="QuadMesh_spark"]
material = SubResource("StandardMaterial3D_spark")
size = Vector2(0.16, 0.16)

[node name="ImpactFX" type="Node3D"]
script = ExtResource("1_impact_fx")

[node name="Sparks" type="GPUParticles3D" parent="."]
cast_shadow = 0
gi_mode = 0
emitting = false
amount = 16
lifetime = 0.35
one_shot = true
explosiveness = 1.0
fixed_fps = 30
interpolate = true
draw_order = 3
local_coords = false
