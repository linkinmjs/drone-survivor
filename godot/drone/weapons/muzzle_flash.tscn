[gd_scene load_steps=5 format=3]

; Destello de boca (`docs/08` §2.10): un `GPUParticles3D` one-shot y una luz
; pulsada de 40 ms. Va colgado del `Muzzle` del `WeaponMount`, o sea 0.35 m por
; delante de la cámara en la dirección de puntería.

[ext_resource type="Script" path="res://drone/weapons/muzzle_flash.gd" id="1_muzzle_flash"]

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_flash"]
lifetime_randomness = 0.2
emission_shape = 1
emission_sphere_radius = 0.008
direction = Vector3(0, 0, -1)
spread = 30.0
initial_velocity_min = 0.25
initial_velocity_max = 0.85
gravity = Vector3(0, 0, 0)
damping_min = 6.0
damping_max = 12.0
scale_min = 0.5
scale_max = 1.0
color = Color(1, 0.82, 0.45, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_flash"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 0.86, 0.55, 1)
emission_enabled = true
emission = Color(1, 0.72, 0.32, 1)
emission_energy_multiplier = 4.0
billboard_mode = 3
billboard_keep_scale = true
disable_receive_shadows = true

[sub_resource type="QuadMesh" id="QuadMesh_flash"]
material = SubResource("StandardMaterial3D_flash")
size = Vector2(0.022, 0.022)

[node name="MuzzleFlash" type="Node3D"]
script = ExtResource("1_muzzle_flash")

[node name="Particles" type="GPUParticles3D" parent="."]
cast_shadow = 0
gi_mode = 0
emitting = false
amount = 10
lifetime = 0.05
one_shot = true
explosiveness = 1.0
local_coords = true
process_material = SubResource("ParticleProcessMaterial_flash")
draw_pass_1 = SubResource("QuadMesh_flash")

[node name="FlashLight" type="OmniLight3D" parent="."]
visible = false
light_color = Color(1, 0.78, 0.42, 1)
light_energy = 0.0
shadow_enabled = false
omni_range = 6.0
