[gd_resource type="Resource" script_class="WeaponProfile" load_steps=6 format=3]

; Arma primaria del MVP con los valores cerrados del Anexo C (`docs/08` §4).
; Todo lo de acá lo ajusta WP-23 sin tocar una línea de código.

[ext_resource type="Script" path="res://drone/weapons/weapon_profile.gd" id="1_profile"]
