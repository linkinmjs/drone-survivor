[gd_resource type="Resource" script_class="EnergyProfile" load_steps=2 format=3]

; Economía de energía del MVP con los valores cerrados del Anexo A/C (`docs/09` §4).
; Todo esto lo ajusta WP-23 sin tocar una línea de código; `docs/09` §6 ya anticipa
; que `base_drain` pueda bajar a 0.35 y `battery_amount` subir a 40 si los 35 s de
; autonomía en combate resultan cortos.

[ext_resource type="Script" path="res://drone/energy/energy_profile.gd" id="1_energy_profile"]

[resource]
script = ExtResource("1_energy_profile")
max_energy = 100.0
base_drain = 0.55
throttle_drain = 0.85
idle_recharge = 1.0
idle_recharge_cap = 10.0
critical_ratio = 0.15
critical_exit_ratio = 0.18
critical_thrust_scale = 0.82
battery_amount = 30.0
emp_drain = 25.0
emp_glitch_seconds = 3.0
respawn_energy = 60.0
publish_epsilon = 0.005
