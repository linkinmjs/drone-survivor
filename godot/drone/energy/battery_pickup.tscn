[gd_scene load_steps=4 format=3]

; Pila de energía (`docs/09` §2.4 y §3.1). Capa 7 (`pickup`), máscara 2 (`drone`),
; esfera de 3.5 m. Es el único `Area3D` del sistema de combate.
;
; **WP-26**: el placeholder de WP-15 —una caja emisiva cian con una luz— pasa a
; ser el prop real `vfx/battery_cell.tscn`: celda con casquillo, bandas emisivas
; `SUCCESS`, halo de seis motas y luz suave. La colisión, la capa, la máscara, el
; script y toda la API quedan **exactamente iguales**: lo único que cambia es lo
; que se ve.
;
; El cambio de cian a verde `SUCCESS` no es un capricho de paleta: `docs/13` §2.1
; reserva el cian para lo que es del enemigo, y una pila cian se leía como «algo
; del jefe». El `Glow` viejo también era cian por eso mismo y se va con la caja;
; la luz de la pila la trae ahora el prop.

[ext_resource type="Script" path="res://drone/energy/battery_pickup.gd" id="1_pickup"]
[ext_resource type="PackedScene" path="res://vfx/battery_cell.tscn" id="2_cell"]

[sub_resource type="SphereShape3D" id="SphereShape3D_pickup"]
radius = 3.5

[node name="BatteryPickup" type="Area3D"]
collision_layer = 64
collision_mask = 2
monitorable = false
script = ExtResource("1_pickup")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("SphereShape3D_pickup")

[node name="Mesh" parent="." instance=ExtResource("2_cell")]
