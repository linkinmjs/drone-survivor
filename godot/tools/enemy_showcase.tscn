; Sol de atardecer compartido (`docs/13` §3.2, WP-24): `world/sun_dusk.tres` pone
; 2400 lux a 3200 K y 6° sobre el horizonte, y `Graphics.register_sun()` le vuelca
; la tabla de sombras del preset. El showcase tenía sol y exposición propios
; —2.4 × 100 000 lux contra f/16 e ISO 100— y quedó 7 pasos fuera de calibración
; cuando WP-24 recalibró `world/environment_battle.tres`.
[node name="Sun" type="DirectionalLight3D" parent="."]
script = ExtResource("7_sun_light")
profile = ExtResource("8_sun_profile")
shadow_enabled = true

[node name="Ground" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="Ground"]
mesh = SubResource("PlaneMesh_ground")

[node name="Shape" type="CollisionShape3D" parent="Ground"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -2, 0)
shape = SubResource("BoxShape3D_ground")

[node name="DebrisPool" type="Node3D" parent="." node_paths=PackedStringArray("rubble_field")]
script = ExtResource("4_debris_pool")
rubble_field = NodePath("RubbleField")

[node name="RubbleField" type="Node3D" parent="DebrisPool"]
script = ExtResource("5_rubble_field")

; Pool de VFX (WP-26): sin él el showcase mostraría las mallas de respaldo de
; WP-19 —el anillo de suelo, la línea de un píxel y el cilindro liso— en vez de
; lo que ve el jugador. Con él, los fotogramas del guion enseñan el decal rojo del
; pisotón, la columna ámbar del asedio, el haz cian del láser, la parábola del
; salto y las chispas de las partes que se desprenden.

[node name="VFXPool" type="Node" parent="."]
script = ExtResource("9_vfx_pool")

[node name="Arachnodroid" parent="." node_paths=PackedStringArray("debris_pool", "rubble_field") instance=ExtResource("3_arachnodroid")]
debris_pool = NodePath("../DebrisPool")
rubble_field = NodePath("../DebrisPool/RubbleField")

