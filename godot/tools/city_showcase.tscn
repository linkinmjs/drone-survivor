[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://tools/city_showcase.gd" id="1_showcase"]
[ext_resource type="Environment" path="res://world/environment_battle.tres" id="2_env"]
[ext_resource type="Script" path="res://city/debris_pool.gd" id="3_debris_pool"]
[ext_resource type="Script" path="res://city/rubble_field.gd" id="4_rubble_field"]
[ext_resource type="CameraAttributesPhysical" path="res://world/camera_attributes_dusk.tres" id="5_camera_attributes"]
[ext_resource type="Script" path="res://world/sun_light.gd" id="6_sun_light"]
[ext_resource type="Resource" path="res://world/sun_dusk.tres" id="7_sun_profile"]

[node name="CityShowcase" type="Node3D"]
script = ExtResource("1_showcase")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")
camera_attributes = ExtResource("5_camera_attributes")

; Sol de atardecer compartido (`docs/13` §3.2, WP-24): `world/sun_dusk.tres` pone
; 2400 lux a 3200 K y 6° sobre el horizonte, y `Graphics` le vuelca la tabla de
; sombras del preset en cuanto el nivel lo registra.
[node name="Sun" type="DirectionalLight3D" parent="."]
script = ExtResource("6_sun_light")
profile = ExtResource("7_sun_profile")

[node name="DebrisPool" type="Node3D" parent="." node_paths=PackedStringArray("rubble_field")]
script = ExtResource("3_debris_pool")
rubble_field = NodePath("RubbleField")

[node name="RubbleField" type="Node3D" parent="DebrisPool"]
script = ExtResource("4_rubble_field")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -274, 128, -184)
fov = 58.0
far = 2000.0
