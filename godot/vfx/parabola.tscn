[gd_scene load_steps=3 format=3]

; Parábola guía del `pounce` (`docs/13` §4, `docs/07` §5.9): el arco balístico
; hasta el punto de caída, **punteado**, 1.3 s de telegrafía.
;
; Punteado y no continuo: a cuarenta metros de vuelo una línea llena se lee como
; una pared y tapa justo el punto de caída, que es el único dato que el jugador
; necesita. Con nueve rayas el ojo completa la curva y ve el suelo entre ellas.
;
; **Rojo de peligro** como el decal del pisotón: los dos anuncian un golpe letal
; al dron (100 de daño desde casco lleno, `docs/07` §5.9), y el jugador no tiene
; que aprender dos códigos de color para la misma idea.
;
; Cero emisores: es telegrafía (`docs/13` §11 #12).

[ext_resource type="Script" path="res://vfx/vfx_guide.gd" id="1_guide"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_arc"]
transparency = 1
blend_mode = 1
shading_mode = 0
cull_mode = 2
vertex_color_use_as_albedo = false
albedo_color = Color(2.6, 0.7, 0.6, 0.8)
disable_receive_shadows = true

[node name="Parabola" type="Node3D"]
script = ExtResource("1_guide")
life_seconds = 0.0
light_fade_seconds = 0.0
decal_seconds = 0.0
mode = 1

[node name="Line" type="MeshInstance3D" parent="."]
top_level = true
cast_shadow = 0
gi_mode = 0
material_override = SubResource("StandardMaterial3D_arc")
