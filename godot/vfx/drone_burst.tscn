[gd_scene load_steps=12 format=3]

; Estallido del dron al ser destruido (`docs/13` §8, `docs/09` §2.8).
;
; **Corto a propósito** (0.6 s): lo que sigue es la estática de la señal y el
; contador de drones del taller (WP-25), y eso es lo que tiene que quedar en
; pantalla. Un estallido largo taparía la transición que cuenta la historia.
;
; Ámbar y blanco, nunca cian: nada propio es cian (`docs/13` §1). Dos emisores:
; las chispas del chasis y el humo negro que queda flotando medio segundo.

[ext_resource type="Script" path="res://vfx/vfx_effect.gd" id="1_effect"]

[sub_resource type="Curve" id="Curve_out"]
_data = [Vector2(0, 1), 0.0, 0.0, 0, 0, Vector2(1, 0), 0.0, 0.0, 0, 0]
