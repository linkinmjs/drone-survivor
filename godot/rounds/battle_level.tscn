[gd_scene load_steps=20 format=3]

[ext_resource type="Script" path="res://rounds/battle_level.gd" id="1_level"]
[ext_resource type="Environment" path="res://world/environment_battle.tres" id="2_env"]
[ext_resource type="Script" path="res://city/city_integrity.gd" id="3_integrity"]
[ext_resource type="PackedScene" path="res://drone/drone_rig.tscn" id="4_rig"]
[ext_resource type="Script" path="res://drone/weapons/impact_fx_pool.gd" id="5_impact_pool"]
[ext_resource type="Script" path="res://drone/weapons/projectile_pool.gd" id="6_projectile_pool"]
[ext_resource type="Script" path="res://city/debris_pool.gd" id="7_debris_pool"]
[ext_resource type="Script" path="res://city/rubble_field.gd" id="8_rubble_field"]
[ext_resource type="Script" path="res://drone/energy/battery_spawner.gd" id="9_battery_spawner"]
[ext_resource type="PackedScene" path="res://drone/energy/battery_pickup.tscn" id="10_battery_pickup"]
[ext_resource type="Script" path="res://rounds/objectives/objective_hud.gd" id="11_objective_hud"]
[ext_resource type="Script" path="res://rounds/round_manager.gd" id="12_round_manager"]
[ext_resource type="Script" path="res://rounds/objectives/objective_sequencer.gd" id="13_sequencer"]
[ext_resource type="PackedScene" path="res://rounds/results/result_card.tscn" id="14_result_card"]
[ext_resource type="Script" path="res://rounds/objectives/objective_defend_city.gd" id="15_defend_city"]
[ext_resource type="Script" path="res://rounds/objectives/objective_break_parts.gd" id="16_break_parts"]
[ext_resource type="Script" path="res://rounds/objectives/objective_defeat_enemy.gd" id="17_defeat_enemy"]
