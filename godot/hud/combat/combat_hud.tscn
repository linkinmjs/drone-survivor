[gd_scene load_steps=18 format=3]

[ext_resource type="Script" path="res://hud/combat/combat_hud.gd" id="1_combat_hud"]
[ext_resource type="Theme" path="res://hud/hud_theme.tres" id="2_hud_theme"]
