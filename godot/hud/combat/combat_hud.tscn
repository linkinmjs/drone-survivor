; HUD de combate del nivel (`docs/12` §4). Capa 20, propiedad del `BattleLevel`:
; sobrevive al respawn porque el dron no es su dueño (`docs/12` §1.1).

[node name="CombatHUD" type="CanvasLayer"]
layer = 20
script = ExtResource("1_combat_hud")

[node name="Root" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_hud_theme")

; Espacio de **pantalla**: el margen de 56 px de los marcadores y el borde al que se
; pega el arco de daño son magnitudes de pantalla, no del lienzo de diseño, así que
; estos dos quedan fuera del `Frame` escalado.

[node name="OffscreenMarkers" type="Control" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_markers")

[node name="DamageDirection" type="Control" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("4_damage")

; Lienzo de diseño de 1280 × 720, el mismo del `FlightHUD`: con el mismo factor de
; escala los dos HUD nunca se pisan a ninguna resolución (`docs/12` §4).

[node name="Frame" type="Control" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
offset_right = 1280.0
offset_bottom = 720.0
mouse_filter = 2

[node name="EnergyBar" type="Control" parent="Root/Frame"]
