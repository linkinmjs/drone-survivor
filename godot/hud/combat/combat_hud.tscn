anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("18_weak_hint")

; Lienzo de diseño de 1280 × 720, el mismo del `FlightHUD`: con el mismo factor de
; escala los dos HUD nunca se pisan a ninguna resolución (`docs/12` §4).

[node name="Frame" type="Control" parent="Root"]
