; Alerta del monitor del taller (`docs/narrativa` §5, WP-25b). Es el primer estado de
; la ronda: tapa el lienzo entero en negro y dibuja el mapa del barrio. Va **antes**
; del `GlitchLayer` para que la estática del corte se dibuje encima de ella.

[node name="AlertScreen" type="Control" parent="Root/Frame"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("21_alert")

; Rayado de monitor viejo sobre el mapa. Es hijo —y no una rutina de dibujo— para
; quedar por encima del `_draw()` del padre sin repetir el bucle de líneas de WP-25.
; El `modulate` lo baja a la mitad: el 35 % con el que la pantalla de carga raya un
; fondo liso, sobre el relleno del 8 % de una manzana, la deja a rayas en vez de
; rayada, y el ámbar pleno del edificio protegido se lee como una persiana.

[node name="Scanlines" type="Control" parent="Root/Frame/AlertScreen"]
modulate = Color(1, 1, 1, 0.5)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("22_scanlines")

; No dibuja: le escribe el desplazamiento del EMP a los catorce anteriores
; (`docs/12` §4.3).

[node name="GlitchLayer" type="Control" parent="Root/Frame"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("17_glitch")

; Estática de señal perdida (`docs/13` §1). Cuelga del `GlitchLayer` —y no del
; `Frame`— para quedar último de todo: tapa la pantalla entera y tiene que dibujarse
; encima del resto del HUD. Arranca apagada.

[node name="StaticBurst" type="Control" parent="Root/Frame/GlitchLayer"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("20_static")
